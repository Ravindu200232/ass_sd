# =============================================================================
# Pubudu POS front-end - environment template
#
# Copy to .env.local (git-ignored) and adjust for your machine:
#
#     cp .env.example .env.local
#
# V-14: the real .env used to be COMMITTED to this repository, because the
# .gitignore was the stock Vite template and contained no .env rule at all. It
# leaked the production and staging backend hostnames. It has now been removed
# from tracking and .env* is ignored.
#
# IMPORTANT: everything prefixed VITE_ is INLINED INTO THE PUBLIC JAVASCRIPT
# BUNDLE at build time. A base URL is fine. An API key, a secret, or a token is
# not - putting one here publishes it to every visitor. Secrets belong in the
# backend's own .env, which is never shipped to a browser.
# =============================================================================

# Base URL of the Laravel API, including the /api prefix. Must be https:// for
# any deployed environment - see V-15.
VITE_API_BASE_URL=https://api.example.com/api

# Google OAuth 2.0 client id for the "Sign in with Google" flow.
#
# A client ID is public by design in the Authorization Code + PKCE flow: it
# identifies the application, it does not authenticate it. The client SECRET
# stays in the backend .env and is never exposed here.
VITE_GOOGLE_CLIENT_ID=

# Where Google redirects after consent. Must match a redirect URI registered on
# the OAuth client exactly, including scheme, host, port and path.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
