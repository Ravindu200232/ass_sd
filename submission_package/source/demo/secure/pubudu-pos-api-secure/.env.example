# =============================================================================
# Pubudu POS API - environment template
#
# Copy to .env and fill in. NEVER commit the resulting .env: it is excluded by
# .gitignore and, on the current shared-hosting layout, would also be
# downloadable over HTTP (see the notes in .htaccess).
#
#   cp .env.example .env
#   php artisan key:generate
#
# V-07 fix: this template previously shipped APP_ENV=local and APP_DEBUG=true.
# Anyone who copied it into production - which is exactly what the Composer
# post-root-package-install script does automatically - got full interactive
# Ignition stack traces, including a dump of every environment variable, on any
# unhandled error. The defaults below are now production-safe; a developer
# opting in to debug output has to do so deliberately.
# =============================================================================

APP_NAME="Pubudu POS API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# -----------------------------------------------------------------------------
# CORS (V-08)
# -----------------------------------------------------------------------------
# Comma-separated list of the exact origins allowed to call this API. There is
# deliberately no wildcard fallback - if this is unset, cross-origin requests
# are refused rather than silently allowed from everywhere.
FRONTEND_URLS=https://pos.example.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' writes every query and payload to disk. Use 'warning' in production.
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pubudu_pos
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Authentication (V-06)
# -----------------------------------------------------------------------------
# Sanctum personal access token lifetime, in minutes. config/sanctum.php reads
# this; it used to be hard-coded to null, meaning tokens never expired.
SANCTUM_TOKEN_EXPIRATION=480

# Cost factor for password hashing. 12 is the Laravel default and a sensible
# floor; raise it if the hardware can absorb the latency.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Google OpenID Connect (Authorization Code + PKCE)
# -----------------------------------------------------------------------------
# Create a "Web application" OAuth 2.0 client at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI below exactly as it appears here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pos.example.com/auth/callback

# Optional: restrict sign-in to a Google Workspace domain. When set, an ID
# token whose "hd" claim does not match is rejected. Leave blank to allow any
# Google account that has been pre-provisioned as a staff user.
GOOGLE_HOSTED_DOMAIN=

# -----------------------------------------------------------------------------
# Session and cache
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Only send the session cookie over HTTPS. Defaults to null (i.e. off) in
# Laravel's stock config, which is wrong for any deployed site.
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Push notifications (OneSignal)
# -----------------------------------------------------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
